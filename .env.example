# 主应用运行目录。数据库和不可变证据都写入这里。
BAGHOLDER_HOME=var

# TradingAgents 独立环境与 OpenAI 兼容模型配置。
TRADINGAGENTS_PYTHON=.runtime/tradingagents/Scripts/python.exe
TRADINGAGENTS_RUNNER=integrations/tradingagents/runner.py
TRADINGAGENTS_LLM_PROVIDER=openai
TRADINGAGENTS_MODEL=
TRADINGAGENTS_API_KEY=
TRADINGAGENTS_BACKEND_URL=

# 实盘默认双关闭；完成券商测试环境验收后才能同时打开。
BAGHOLDER_LIVE_ENABLED=false
BAGHOLDER_ACCOUNT_LIVE_ENABLED=false
BAGHOLDER_VNPY_PYTHON=.runtime/vnpy/Scripts/python.exe
BAGHOLDER_VNPY_GATEWAY_PLUGIN=
BAGHOLDER_VNPY_GATEWAY_SHA256=

# 实际值从操作系统凭据存储注入；不要把密钥写入此文件。
BAGHOLDER_TRADING_NODE_SECRET_HEX=
